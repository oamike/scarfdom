<p id="notice"><%= notice %></p>

<table class="header-table">
  <tr><td>
    <h1><%= link_to "Scarfdom", root_path %></h1>
  </td>
  <td>
    <%= @user.username %><br>
    <%= link_to 'My Scarves', user_items_path %>
  </td>
<td></td></tr>
</table>
<%= paginate @items, window: 2 %>        <%= page_entries_info @items, entry_name: 'scarf' %>
<p></p>
<hr/>
<table>
  <tbody>
    <% @items.each do |item| %>
      <tr>
        <table>
          <tr>
            <td>
              <table>
                <tr><td>
                  <%= link_to item.name, item, {class: "scarf-name"}   %>
                </td>
                <td>
                  <%= render partial: "user_item", locals: { user_data: item.user_data } %>
                </td>
              </tr>
              </table>
          <tr>
            <td>
              <p><%= image_render(item.images[0]&.image_url) %></p>
              <p><%= image_render(item.images[1]&.image_url) %></p>
            </td>
          </tr>
      </table>
      </tr>
      <% end %>
  </tbody>
</table>

<br>
<%= paginate @items, window: 2 %>
<%= link_to 'New Item', new_item_path %>
